###############################################
# Global security headers (safe defaults)
###############################################
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), clipboard-read=(), clipboard-write=(), display-capture=(), document-domain=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), wake-lock=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Vary: Accept-Encoding

###############################################
# HTML files - no cache for index, short cache for others
###############################################
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=3600

###############################################
# Service Worker - 常に再検証
# /sw.js は Issue #28 で撤去した旧SWを解除するためだけの自己解除スクリプト。
# ここが長期キャッシュされると解除コードが届かず、cache-first の旧SWが延命する。
# Netlify の既定値も同じ `public, max-age=0, must-revalidate` なので今日の実効差は無い。
# 明示する目的は意図の記録と、将来 `/*.js` のような広いルールが足されたときの目印。
# ただし Netlify はクロスルールの優先順位を公式に規定していないため、この明示が
# 必ず勝つとは限らない。広いルールを足すときは実際にヘッダを計測して確認すること。
# Chrome 68+ / updateViaCache: 'imports' は SW スクリプトの HTTP キャッシュを無視するが、
# それ以前のブラウザは尊重する（max-age は 86400 で頭打ち）。
###############################################
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

###############################################
# Static assets with hash - 1 year cache
###############################################
/assets/*
  Cache-Control: public, max-age=31536000, immutable

###############################################
# Fonts - 1 year cache
###############################################
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

###############################################
# Images - 30 days cache
###############################################
/favicon.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/ogp.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800

###############################################
# SEO - 1 day cache
###############################################
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

